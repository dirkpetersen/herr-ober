# /etc/ober/lego.env, mode 600, owner root. Holds the DNS API token: keep it out of ober.yaml.
LEGO_EMAIL=admin@example.com
LEGO_DOMAIN=s3.example.com
# The DNS provider name for lego --dns and its credentials (see https://go-acme.github.io/lego/dns/)
LEGO_DNS_PROVIDER=cloudflare
CLOUDFLARE_DNS_API_TOKEN=change-me
# Only when certs.path in ober.yaml is a directory:
#OBER_CERT_NAME=s3.pem
